# LLM Provider Configuration
GROQ_API_KEY=your_groq_api_key_here

# SMTP Email Configuration
# Note: For Gmail, generate a 16-character App Password from Google Account > Security > 2-Step Verification > App passwords
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password_here

# Optional Alternative aliases recognized by the mailer
# SENDER_EMAIL=your_email@gmail.com
# EMAIL_PASSWORD=your_gmail_app_password_here

# FastAPI Backend Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Optional API Security: Set this to require an X-API-Key header on protected endpoints in production
# API_SECRET_KEY=your-production-secret-api-key

# File Attachment Configuration
UPLOAD_DIR=storage/uploads
MAX_ATTACHMENT_SIZE_MB=10
DEFAULT_ATTACHMENT_PATH=storage/default_attachments/Aman_Mulla_Resume.pdf
ATTACH_DEFAULT_BY_DEFAULT=true

# MCP Server Configuration
EMAIL_API_BASE_URL=http://127.0.0.1:8000
EMAIL_API_KEY=
MCP_HOST=0.0.0.0
MCP_PORT=8001
MCP_TRANSPORT=streamable-http
HTTP_TIMEOUT=60.0

# ngrok Tunnel Configuration (Get free auth token at https://dashboard.ngrok.com)
NGROK_AUTHTOKEN=your_ngrok_authtoken_here
